# Local Sync Agent Configuration
# Copy this to .env in the same directory as local_sync_agent.py

# Your Render backend URL (no trailing slash)
RENDER_BACKEND_URL=https://your-app.onrender.com

# Shared secret key — must match SYNC_API_KEY in Render env vars
SYNC_API_KEY=change-me-to-a-strong-random-key

# Path to MT5 terminal (optional — leave empty for default)
MT5_PATH=
